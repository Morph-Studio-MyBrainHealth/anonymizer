[Unit]
Description=Anonymizer Flask Application
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/anonymizer
Environment="PATH=/home/ubuntu/anonymizer/venv/bin"
ExecStart=/home/ubuntu/anonymizer/venv/bin/gunicorn --workers 3 --bind 0.0.0.0:8000 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target 